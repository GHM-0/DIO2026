APP_VERSION=0.0.1
APP_IMAGE=desafio
APP_PORT=8000

DB_CONTAINER=mysql_server
APP_CONTAINER=desafio

APP_DB=./.db

CHARSET=utf8

MYSQL_PORT=3306
MYSQL_DEV_XPORT=33060
MYSQL_HOST=localhost
MYSQL_DATABASE=DIOBANK
MYSQL_USER=app_user
MYSQL_ROOT=root
MYSQL_PASSWORD=app_user_pass
MYSQL_ROOT_PASSWORD=root_pass

SECRET_KEY="NOTHING-is-secret-key-needs-to-be-longer-than-32-chars"
ALGORITHM="HS256"

DB_PROFILES={"USER_ASYNC": {"conn_driver": "aiomysql", "user_name": "MYSQL_USER", "user_pass": "MYSQL_PASSWORD", "db_name": "MYSQL_DATABASE"}, "ROOT_SYNC": {"conn_driver": "pymysql", "user_name": "MYSQL_ROOT", "user_pass": "MYSQL_ROOT_PASSWORD", "db_name": "MYSQL_DATABASE"}, "ROOT_SYNC_SETUP": {"conn_driver": "pymysql", "user_name": "MYSQL_ROOT", "user_pass": "MYSQL_ROOT_PASSWORD", "db_name": null}}
