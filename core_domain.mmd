classDiagram
    class Account {
        +int id
        +Balance balance
        +deposit(amount: Amount)
        +withdraw(amount: Amount)
    }

    class Transaction {
        <<abstract>>
        #int id
        #Account _operand
        #Account _counterparty
        #Amount _amount
        #TransactionType _type
        #datetime _timestamp
        #bool|None _status
        +__init__(id: int|None, operand: Account, counterparty: Account|None, type: TransactionType, amount: Decimal, timestamp: datetime|None)
        +account_orig_id: int|None
        +account_dest_id: int|None
        +amount: Decimal
        +type: TransactionType
        +id: int|None
        +timestamp: datetime|None
        +status: str
        #_operate()* TransactionResult
        #_build_result(success: bool, message: str) TransactionResult
        +__eq__(other)
        +__repr__()
    }

    class Credit {
        +__init__(id: int|None, operand: Account, type: TransactionType, amount: Decimal, timestamp: datetime|None)
        #_operate() TransactionResult
    }

    class Debit {
        +__init__(id: int|None, operand: Account, type: TransactionType, amount: Decimal, timestamp: datetime|None)
        #_operate() TransactionResult
    }

    class Transference {
        +__init__(id: int|None, operand: Account, counterparty: Account, type: TransactionType, amount: Decimal, timestamp: datetime|None)
        #_operate() TransactionResult
    }

    class Amount {
        <<ValueObject>>
        +Decimal value
        +validate(value: Decimal) Amount
    }

    class Balance {
        <<ValueObject>>
        +Decimal value
        +validate(value: Decimal) Balance
    }

    class TransactionResult {
        <<ValueObject>>
        +bool success
        +str message
        +int transaction_id
        +TransactionType transaction_type
        +Amount amount
        +int origin_id
        +int destination_id
        +datetime timestamp
    }

    class TransactionType {
        <<enumeration>>
        CREDIT
        DEBIT
        TRANSFERENCE
    }

    class TransactionException {
        <<exception>>
    }
    class InvalidId { <<exception>> }
    class InvalidAccount { <<exception>> }
    class SameAccountException { <<exception>> }
    class InvalidAmount { <<exception>> }

    Transaction <|-- Credit
    Transaction <|-- Debit
    Transaction <|-- Transference

    Transaction o-- Account : "_operand/_counterparty"
    Transaction o-- Amount : "_amount"
    Account o-- Balance : "balance"

    Transaction ..> TransactionResult : "returns"
    Transaction ..> TransactionException : "throws"

    TransactionException <|-- InvalidId
    TransactionException <|-- InvalidAccount
    TransactionException <|-- SameAccountException
    TransactionException <|-- InvalidAmount

    TransactionResult --> TransactionType
    TransactionResult --> Amount
    Transaction --> TransactionType